{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Itqahn Evidence Pack Manifest",
  "type": "object",
  "required": [
    "pack_id",
    "git_commit",
    "build_id",
    "created_at",
    "compliance_tier",
    "artifacts",
    "signature_hash"
  ],
  "properties": {
    "pack_id": {
      "type": "string"
    },
    "git_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{7,40}$"
    },
    "build_id": {
      "type": "string"
    },
    "created_at": {
      "type": "string"
    },
    "compliance_tier": {
      "type": "string",
      "enum": [
        "tier0",
        "tier1",
        "tier2"
      ]
    },
    "artifacts": {
      "type": "object",
      "required": [
        "sbom",
        "provenance",
        "scans",
        "tests"
      ],
      "properties": {
        "sbom": {
          "type": "object",
          "required": [
            "present",
            "path"
          ],
          "properties": {
            "present": {
              "type": "boolean"
            },
            "path": {
              "type": "string"
            }
          }
        },
        "provenance": {
          "type": "object",
          "required": [
            "present",
            "path"
          ],
          "properties": {
            "present": {
              "type": "boolean"
            },
            "path": {
              "type": "string"
            }
          }
        },
        "scans": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "type",
              "path"
            ],
            "properties": {
              "type": {
                "type": "string"
              },
              "path": {
                "type": "string"
              }
            }
          }
        },
        "tests": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "type",
              "path"
            ],
            "properties": {
              "type": {
                "type": "string"
              },
              "path": {
                "type": "string"
              }
            }
          }
        },
        "approvals": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "type",
              "path"
            ],
            "properties": {
              "type": {
                "type": "string"
              },
              "path": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "signature_hash": {
      "type": "string"
    }
  }
}
